# Copy to .env and fill in real values.

ENVIRONMENT=local
LOG_LEVEL=INFO
SQL_ECHO=false

DATABASE_URL=postgresql+asyncpg://querypilot:qp_dev@localhost:55432/querypilot
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-random-48-byte-secret

# Access token lifetime in minutes (1-1440)
ACCESS_TOKEN_TTL_MINUTES=15

# Refresh token lifetime in days (1-365)
REFRESH_TOKEN_TTL_DAYS=30

# Magic link lifetime in minutes (1-1440)
MAGIC_LINK_TTL_MINUTES=15

# One of: HS256, HS384, HS512
JWT_ALGORITHM=HS256

# Encrypts customer database credentials at rest. Rotating it makes every
# stored credential undecryptable, so re-encrypt before rotating. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=replace-me-with-a-fernet-key


# Which provider answers a question: gemini, ollama, or auto.
# `auto` prefers Gemini and falls back to Ollama. Both sets of settings below
# can be filled in at the same time -- this picks between them.
AI_PROVIDER=auto

# Optional. Without a key QueryPilot still works -- you write the SQL by hand.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. A local Ollama is a second provider that costs nothing at all.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# The context window Ollama gives the model. It is memory, not just a limit.
# Lower it on a small machine.
OLLAMA_NUM_CTX=4096

# How long Ollama keeps the model in memory after the last question. "0"
# unloads it straight away -- smoother on a small laptop, but every question
# reloads the model from disk.
OLLAMA_KEEP_ALIVE=0

# How long a query may run against the customer's database (100-600000).
# This is the ceiling for every plan -- each tier asks for less, and none of
# them can ask for more. Lower it to squeeze every tier, raise it to let the
# paid tiers use their longer timeouts.
QUERY_EXECUTION_TIMEOUT_MS=60000
